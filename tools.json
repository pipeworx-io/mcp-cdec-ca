  {
    "name": "latest",
    "description": "Most recent REAL reading for (station, sensor), looking back three days. CDEC writes -9999 into slots it has no reading for and the current day's trailing hours are routinely unwritten, so this skips those and reports how many missing slots it skipped rather than returning the marker as a number.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "station_id": {
